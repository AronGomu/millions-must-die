{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://millions-must-die.local/schemas/lab-raw-sample-v1.schema.json",
  "title": "lab-raw-sample-v1",
  "type": "object",
  "additionalProperties": false,

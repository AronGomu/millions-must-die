{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://millions-must-die.local/schemas/benchmark-report-v1.schema.json",
  "title": "benchmark-report-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifests",
    "absolute_gate",
    "scale_results",
    "verdict",
    "verdict_reason"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "benchmark-report-v1"
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_version",
        "scenario_sha256",
        "backend",
        "adapter",
        "shader_manifest_version",
        "engine_version",
        "policy_id",
        "frames_in_flight",
        "gpu_queue_latency_note"
      ],
      "properties": {
        "scenario_version": { "type": "string", "minLength": 1 },
        "scenario_sha256": { "type": "string", "minLength": 1 },
        "backend": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string" },
        "shader_manifest_version": { "type": "integer", "minimum": 1 },
        "engine_version": { "type": "string", "minLength": 1 },
        "policy_id": { "type": "string", "minLength": 1 },
        "frames_in_flight": { "type": "integer", "const": 2 },
        "gpu_queue_latency_note": {
          "type": "string",
          "minLength": 1,
          "description": "Must state fence latency is not true GPU execution time."
        }
      }
    },
    "absolute_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_count",
        "median_p95_limit_ms",
        "median_p99_limit_ms",
        "nmad_limit",
        "relative_gates_enabled"
      ],
      "properties": {
        "agent_count": { "type": "integer", "const": 50000 },
        "median_p95_limit_ms": { "type": "number", "const": 16.67 },
        "median_p99_limit_ms": { "type": "number", "const": 25.0 },
        "nmad_limit": { "type": "number", "const": 0.03 },
        "relative_gates_enabled": { "type": "boolean", "const": false }
      }
    },
    "scale_results": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_count",
          "blocking",
          "stretch",
          "trials",
          "median_p95_frame_service_ms",
          "median_p99_frame_service_ms",
          "nmad_p95",
          "nmad_p99",
          "final_drain_ms",
          "submitted_frames",
          "completed_frames",
          "max_in_flight",
          "verdict",
          "verdict_reason"
        ],
        "properties": {
          "agent_count": {
            "type": "integer",
            "enum": [1000, 10000, 50000, 100000]
          },
          "blocking": { "type": "boolean" },
          "stretch": { "type": "boolean" },
          "trials": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "sample_count",
                "p95_frame_service_ms",
                "p99_frame_service_ms",
                "median_sim_ms",
                "median_upload_ms",
                "median_gpu_queue_latency_ms"
              ],
              "properties": {
                "index": { "type": "integer", "minimum": 0 },
                "sample_count": { "type": "integer", "minimum": 0 },
                "p95_frame_service_ms": { "type": "number" },
                "p99_frame_service_ms": { "type": "number" },
                "median_sim_ms": { "type": "number" },
                "median_upload_ms": { "type": "number" },
                "median_gpu_queue_latency_ms": { "type": "number" }
              }
            }
          },
          "median_p95_frame_service_ms": { "type": "number" },
          "median_p99_frame_service_ms": { "type": "number" },
          "nmad_p95": { "type": "number" },
          "nmad_p99": { "type": "number" },
          "final_drain_ms": { "type": "number" },
          "submitted_frames": { "type": "integer", "minimum": 0 },
          "completed_frames": { "type": "integer", "minimum": 0 },
          "max_in_flight": { "type": "integer", "minimum": 0, "maximum": 2 },
          "verdict": {
            "type": "string",
            "enum": ["pass", "fail", "inconclusive", "recorded", "error"]
          },
          "verdict_reason": { "type": "string" }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "inconclusive", "recorded", "error"]
    },
    "verdict_reason": { "type": "string" }
  }
}
